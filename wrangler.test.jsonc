{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "readr-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "d1_databases": [
    {
      "binding": "READR_DB",
      "database_name": "readr",
      "database_id": "837b40b1-b768-4071-a0b0-d4010f508e7a",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "EXTRACT_RATE_LIMITER",
      "namespace_id": "812734",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
