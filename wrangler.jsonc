{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "readr",
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "readr.overhawl.app",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "vars": {
    "APP_ENV": "production"
  },
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "overhawl-auth",
      "entrypoint": "AuthService",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "READR_DB",
      "database_name": "readr",
      "database_id": "837b40b1-b768-4071-a0b0-d4010f508e7a",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "EXTRACT_RATE_LIMITER",
      "namespace_id": "812734",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
